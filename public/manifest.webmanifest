{
  "name": "Cosmossian: Interactive 3D Map of the Universe",
  "short_name": "Cosmossian",
  "description": "Explore the universe in 3D, from the surface of Mars to distant galaxies, built with real astronomy data.",
  "id": "/",
  "start_url": "/?source=app",
  "scope": "/",
  "display": "fullscreen",
  "display_override": [
    "fullscreen",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#000000",
  "categories": [
    "education",
    "entertainment"
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Watch on TV",
      "short_name": "TV mode",
      "url": "/?tv=1",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/screens/wide.jpg",
      "sizes": "1280x720",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "The Solar System in Cosmossian"
    },
    {
      "src": "/screens/narrow.jpg",
      "sizes": "721x1601",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Cosmossian on a phone"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
