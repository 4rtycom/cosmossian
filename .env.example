# Copy to .dev.vars for local `npx wrangler dev`.
# .dev.vars is gitignored. On Cloudflare, set this with:
#   npx wrangler secret put REFRESH_KEY
REFRESH_KEY=replace-with-a-long-random-string

# Turnstile secret key. Locally, use Cloudflare's always-pass test key below; on Cloudflare:
#   npx wrangler secret put TURNSTILE_SECRET   (secret key of the "Cosmossian title screen" widget)
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
